PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Database & Redis
MONGO_URI=mongodb://localhost:27017/inventory-management
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Authentication Secrets
JWT_SECRET=your_jwt_secret_here
